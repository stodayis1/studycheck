   "write": [
    {
     "cue": "순서가 뒤집히는",
     "tex": "$(g\\circ f)^{-1}=f^{-1}\\circ g^{-1}$",
     "color": "red",
     "underline": true
    },
    {
     "cue": "항등함수라서 사라지죠",
     "tex": "$f\\circ f^{-1}=I$",
     "color": "blue"
    }
   ]
  },
  {
   "pose": "D",
   "bubble": "식을 줄이기",
   "say": "이걸 써서 식을 줄여 볼게. [[쓰기]] 앞에 붙은 에프와 에프 인버스가 지워지고, 에프 이는 삼으로 나오죠. // {강조 그래서 결국 지 인버스 삼만 구하면 되는 거야.}",
   "write": [
    {
     "quiet": true,
     "tex": "$(f\\circ(g\\circ f)^{-1}\\circ f)(2)=(f\\circ f^{-1}\\circ g^{-1}\\circ f)(2)$"
    },
    {
     "quiet": true,
     "indent": 1,
     "tex": "$=(g^{-1}\\circ f)(2)=g^{-1}(f(2))$"
